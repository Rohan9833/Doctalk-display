# Copy this file to .env and fill in your deployment values.
MONGODB_URI=
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Sender address must be permitted by your SMTP provider.
# EMAIL_FROM="DocTalk <your-sender@digilateral.com>"
EMAIL_FROM="DocTalk <youremail.com>"

# SMTP email configuration (Nodemailer)
EMAIL_HOST=*********
EMAIL_PORT=****
EMAIL_SECURE=false
EMAIL_USER=*********
EMAIL_PASS=********